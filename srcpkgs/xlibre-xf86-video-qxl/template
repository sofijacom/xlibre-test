LDFLAGS="-Wl,-z,lazy"

pre_configure() {
    NOCONFIGURE=1 ./autogen.sh

    export CC=aarch64-linux-gnu-gcc
    export CFLAGS="$CFLAGS"
    export LDFLAGS="$LDFLAGS"

    ./configure \
        --host=aarch64-linux-gnu \
        --build=x86_64-pc-linux-gnu \
        --prefix=/usr \
        --disable-static \
        "$CONFIGURE_ARGS"
}


post_install() {
  vlicense COPYING
}

