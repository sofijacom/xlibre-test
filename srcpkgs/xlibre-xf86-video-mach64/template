checksum=8118cd54d51163fe9c6246a4f02a9457d5696167a469607fd9539a02b3a2e9af

LDFLAGS="-Wl,-z,lazy"

pre_configure() {
	autoreconf -fi
}

# Создаем пустые заглушки для отсутствующих заголовков VBE/VGA
post_extract() {
	mkdir -p "${wrksrc}/stub-includes/xorg"
	touch "${wrksrc}/stub-includes/xorg/vbe.h"
	touch "${wrksrc}/stub-includes/xorg/compiler.h" 
	touch "${wrksrc}/stub-includes/xorg/vgaHW.h"
	
	# Говорим GCC искать наши заглушки в первую очередь
	export CFLAGS="-I${wrksrc}/stub-includes $CFLAGS"
	export CPPFLAGS="-I${wrksrc}/stub-includes $CPPFLAGS"
}

post_install() {
	vlicense COPYING
}

