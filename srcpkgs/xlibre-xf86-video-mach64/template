# Template file for 'xf86-video-mach64'
pkgname=xlibre-xf86-video-mach64
_pkgname=xf86-video-mach64
version=25.0.0
revision=3
# archs="i686* x86_64*"
build_style=gnu-configure
configure_args="--prefix=/usr --enable-kms-only --disable-dri --disable-vbe --disable-vgahw --disable-int10"
hostmakedepends="pkg-config xlibre-xserver-devel xorgproto xorg-util-macros autoconf automake libtool git gawk"
makedepends="xlibre-xserver-devel xorgproto fakeroot gawk gettext pkgconf"
depends="virtual?xserver-abi-video-25_1"
short_desc="XLibre fork of X.Org ATI Rage Pro video driver"
maintainer="Sofiya <sofiya@v.com>"
license="MIT"
provides="xf86-video-mach64-${version}_${revision}"
replaces="xf86-video-mach64>=0"
homepage="https://github.com/X11Libre/xf86-video-mach64"
